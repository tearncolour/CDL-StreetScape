<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CDLC.TS.Preview</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <!-- The painter and the pure geometry, compiled as they are into a program that writes the pictures as PNG files to look at. -->
  <ItemGroup>
    <Compile Include="..\..\Render\LegendPainter.cs" Link="Mod\LegendPainter.cs" />
    <Compile Include="..\..\Render\GuidePainter.cs" Link="Mod\GuidePainter.cs" />
    <Compile Include="..\..\Render\LedScreens.cs" Link="Mod\LedScreens.cs" />
    <Compile Include="..\..\Render\CustomPictures.cs" Link="Mod\CustomPictures.cs" />
    <Compile Include="..\..\Snap\*.cs" Link="Mod\Snap\%(Filename)%(Extension)" />
    <Compile Include="..\..\Geo\*.cs" Link="Mod\Geo\%(Filename)%(Extension)" />
    <Compile Include="..\..\Geo\Signs\*.cs" Link="Mod\Geo\Signs\%(Filename)%(Extension)" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
